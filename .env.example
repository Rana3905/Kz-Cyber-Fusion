# ─────────────────────────────────────────────
# KZ Cyber Fusion — Environment Variables
# AFM AI Hackathon 2026 | Track 2: AI Shield
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ──────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Backend (FastAPI) ─────────────────────────
DATABASE_URL=sqlite:///./kzcyberfusion.db
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────
VITE_API_URL=http://localhost:8000

# ── Backend weights (override if needed) ──────
WEIGHT_PHISHING=0.25
WEIGHT_LEAK=0.20
WEIGHT_ANOMALY=0.20
WEIGHT_DEEPFAKE=0.15
WEIGHT_NETWORK=0.10
WEIGHT_LOGS=0.10
